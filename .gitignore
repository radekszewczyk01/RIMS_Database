# Ignore everything in this repo by default
*

# Keep this file
!.gitignore

# Keep LaTeX source and Markdown docs
!*.tex
!*.md

# Keep sql directory and its SQL files (plus readme)
!sql/
sql/*
!sql/*.sql
!sql/*.md
!sql/examples/
sql/examples/*
!sql/examples/*.sql

# Keep scripts directory and its shell/markdown files
!scripts/
scripts/*
!scripts/*.sh
!scripts/*.md
!scripts/*.py
!scripts/db/
scripts/db/*
!scripts/db/*.sh
!scripts/export/
scripts/export/*
!scripts/export/*.sh
!scripts/examples/
scripts/examples/*
!scripts/examples/*.sh

# Keep docs site for GitHub Pages
!docs/
docs/*
!docs/index.html
!docs/README.md
!docs/schema.sql
!docs/csv/
docs/csv/*
!docs/csv/*.csv

# Keep copilot_input directory and its Markdown files
!copilot_input/
copilot_input/*
!copilot_input/*.md
